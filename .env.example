# Copy this file to server/.env and fill in real values.
# Never commit the real .env file.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local example:   postgresql://postgres:postgres@localhost:5432/ravers_dev
# Supabase/Neon/Render will give you a full connection string like this.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ravers_dev
# Set to true when connecting to a managed provider that requires SSL
# (Supabase, Neon, Render Postgres all need this in production).
DATABASE_SSL=false

# --- Auth ---
# Use a long, random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# Use * only in local development.
CLIENT_URL=http://localhost:8888

# --- Payments (Paystack) ---
# Leave blank to run checkout in mock/dev mode (orders are marked paid
# automatically). Add real keys to enable live Paystack payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=5

# --- Initial admin account (used by `npm run create-admin`) ---
ADMIN_NAME=RAVERS Admin
ADMIN_EMAIL=admin@ravers.example
ADMIN_PASSWORD=change_this_before_running
